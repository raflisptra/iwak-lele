# Salin file ini menjadi .env, lalu isi konfigurasi lokal yang benar.
# Jangan pernah membagikan file .env yang berisi password.

PORT=3000

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=monitoring_lele
PGUSER=postgres
PGPASSWORD=

# Frontend: masukkan origin tempat index.html dijalankan.
# Contoh origin lokal bergantung pada Live Server/port yang kamu gunakan.
FRONTEND_ORIGIN=

# MQTT: kosongkan sampai broker MQTT sudah tersedia.
# Contoh format URL: mqtt://alamat-broker:1883
MQTT_URL=
MQTT_TOPIC=
