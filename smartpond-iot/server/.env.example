# Copy to .env and replace every CHANGE_ME value. Never commit .env.
PORT=3000
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USER=backend
MQTT_PASSWORD=CHANGE_ME_MQTT_BACKEND_PASSWORD
# 32+ unpredictable characters. Shared by the HTTP and WebSocket nodes.
DEVICE_TOKEN=CHANGE_ME_TO_LONG_RANDOM_DEVICE_TOKEN
# AES-256: EXACTLY 64 hexadecimal characters, and identical to firmware secrets.h
AES_KEY_HEX=CHANGE_ME_TO_64_HEX_CHARACTERS
DB_PATH=./data/smartpond.sqlite
# Optional: only for npm run simulate (the MQTT test publisher)
TEST_MQTT_USER=pbllele
TEST_MQTT_PASSWORD=CHANGE_ME_MQTT_NODE_PASSWORD
